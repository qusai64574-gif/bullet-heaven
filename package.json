{
  "name": "bullet-heaven",
  "version": "1.0.0",
  "description": "A bullet-heaven roguelike survival game",
  "main": "electron-main.js",
  "scripts": {
    "start:server": "cd server && npm start",
    "start:client": "cd client && npx serve .",
    "build": "electron-builder --win",
    "dev": "concurrently \"npm run start:server\" \"npm run start:client\""
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.0"
  },
  "build": {
    "appId": "com.bulletheaven.game",
    "productName": "Bullet Heaven",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "client/**/*",
      "electron-main.js"
    ],
    "extraResources": [
      {
        "from": "client/",
        "to": "client/"
      }
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
